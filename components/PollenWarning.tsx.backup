        display: 'flex',
        alignItems: 'center',
        gap: '6px',
        padding: '4px 8px',
        borderRadius: '12px',
        backgroundColor: bgColor,
        border: `1px solid ${color}`,
        fontSize: '12px',
        fontWeight: '500'
      }}
      role="status"
      aria-label={`${typeLabel} pollen: ${levelText} level${value ? `, index ${value.toFixed(1)}` : ''}`}
    >
      {/* Color-coded circle indicator */}
      <div
        style={{
          width: '8px',
          height: '8px',
          borderRadius: '50%',
          backgroundColor: color,
          flexShrink: 0
        }}
        aria-hidden="true"
      />
      
      {/* Pollen type icon */}
      <img 
        src={getPollenTypeIcon(type)}
        alt=""
        style={{ width: '14px', height: '14px', opacity: 0.8 }}
        aria-hidden="true"
      />
      
      {/* Type and level text */}
      <span style={{ color: '#374151', fontWeight: '600' }}>
        {typeLabel}
      </span>
      <span style={{ color: color, fontWeight: '700' }}>
        {levelText}
      </span>
      
      {/* Optional numerical index */}
      {value && value > 0 && (
        <span style={{ color: '#6b7280', fontSize: '11px', fontWeight: '500' }}>
          ({getPollenIndex(value)})
        </span>
      )}
    </div>
  );
}

