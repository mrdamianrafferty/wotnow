# Vercel ignore file — keep uploads lean and deterministic
# Anything listed here will NOT be uploaded by the Vercel CLI.
# (It does NOT affect what Git tracks.)

# --- Vercel / VCS ---
.vercel
.git

# --- Dependencies & caches ---
node_modules
.pnpm-store
.yarn
.npm
.turbo
.pnp.*
.bun
bun.lockb
# NOTE: Do NOT ignore lockfiles; they are needed for reproducible installs
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Build artefacts ---
.next
out
dist
.vercel/output
*.map

# --- Tests & tooling (heavy) ---
coverage
.storybook
storybook-static
cypress
playwright-report
playwright/.cache
__tests__
*.test.*
*.spec.*
jest.config.js

# --- Editors & OS ---
.vscode
.idea
.DS_Store
Thumbs.db
**/.DS_Store

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env files (keep example only) ---
.env*
!.env.example
.env.local
.env.development
.env.*.local

# --- Temp & misc ---
.cache
*.tmp
*.temp
tmp
temp

# --- Scripts/docs not needed in production upload ---
# `scripts/*`, not `scripts/`, because gitignore semantics will not re-include a
# file whose PARENT DIRECTORY is excluded — the negation below is silently dead
# under `scripts/`, and the failure looks identical to having no negation at all.
scripts/*
# The one script the BUILD runs. `prebuild` bakes the share photography, and an
# ignored script is not a script: the deploy failed with ERR_MODULE_NOT_FOUND on
# a file that exists in the repo and had simply never been uploaded.
!scripts/prebake-call-images.ts
docs/
examples/
archive/
/services/
ios/
ios-godaisy/
ios-growdaisy/
ios-findr/
android/
# `android-godaisy/` and `android-growdaisy/` were added to the repo after this
# list was written and never mirrored into it, which cost a production deploy:
#
#   Total bundle size (294.48 MB) exceeds the maximum function size (225 MB)
#
# The reason a listed-in-.gitignore build directory reached the upload at all is
# the trap worth remembering: THE VERCEL CLI READS `.gitignore` ONLY WHEN THERE
# IS NO `.vercelignore`. Once this file exists it replaces `.gitignore`
# entirely, so every Gradle artefact under `android-godaisy/app` — 108 MB of it,
# ignored by git, invisible in `git status` — was being uploaded on every
# `npm run deploy`. Only 57 files in each directory are actually tracked.
#
# The push-to-main deploy was unaffected: it builds from the repository, which
# never contained any of this. Only the CLI path broke, which is why it went
# unnoticed.
android-godaisy/
android-growdaisy/
# Neither is imported by anything under pages/, lib/, components/ or utils/.
img-optimizer/
store-assets/
test-*.js
test-*.ts
debug-*.js
verify-*.js
check-*.js
smoke-*.ts

# --- Large asset buckets (exclude originals) ---
public/raw-assets
public/originals
public/videos
public/screenshots
assets/originals

# --- Unused or development-only assets ---
public/nasa-moon/
public/debug-*.js
public/css/

# --- Weather icons build/dev files (keep design/fill/final SVGs) ---
public/weather-icons/.github/
public/weather-icons/scripts/
public/weather-icons/design/brand*/
public/weather-icons/design/fill/*.html
public/weather-icons/design/line/
public/weather-icons/.gitignore
public/weather-icons/.editorconfig
public/weather-icons/package.json
public/weather-icons/pnpm-lock.yaml
public/weather-icons/README.md
public/weather-icons/LICENSE
public/weather-icons/*.html

# --- Duplicate font files (keep modern formats + fallbacks) ---
public/font/*.eot
public/font/*.svg
# Keep: woff2 (modern), woff (fallback), ttf (old browsers)

# --- Oxanium font extras (if using system fonts instead) ---
public/Oxanium/README.txt
public/Oxanium/OFL.txt
public/Oxanium/static/

# --- Python envs (if present) ---
.venv/
venv/
__pycache__/
*.pyc

# --- Exclude large PNGs ---
public/PNGS

# --- Duplicate/unused assets in pages folder ---
pages/assets/
pages/*.png
