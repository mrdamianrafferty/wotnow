# Vercel ignore file — keep uploads lean and deterministic
# Anything listed here will NOT be uploaded by the Vercel CLI.
# (It does NOT affect what Git tracks.)

# --- Vercel / VCS ---
.vercel
.git

# --- Dependencies & caches ---
node_modules
.pnpm-store
.yarn
.npm
.turbo
.pnp.*
.bun
bun.lockb
# NOTE: Do NOT ignore lockfiles; they are needed for reproducible installs
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Build artefacts ---
.next
out
dist
.vercel/output
*.map

# --- Tests & tooling (heavy) ---
coverage
.storybook
storybook-static
cypress
playwright-report
playwright/.cache
__tests__
*.test.*
*.spec.*
jest.config.js

# --- Editors & OS ---
.vscode
.idea
.DS_Store
Thumbs.db
**/.DS_Store

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env files (keep example only) ---
.env*
!.env.example
.env.local
.env.development
.env.*.local

# --- Temp & misc ---
.cache
*.tmp
*.temp
tmp
temp

# --- Scripts/docs not needed in production upload ---
scripts/
docs/
examples/
archive/
/services/
ios/
ios-godaisy/
ios-growdaisy/
ios-findr/
android/
test-*.js
test-*.ts
debug-*.js
verify-*.js
check-*.js
smoke-*.ts

# --- Large asset buckets (exclude originals) ---
public/raw-assets
public/originals
public/videos
public/screenshots
assets/originals

# --- Unused or development-only assets ---
public/nasa-moon/
public/debug-*.js
public/css/

# --- Weather icons build/dev files (keep design/fill/final SVGs) ---
public/weather-icons/.github/
public/weather-icons/scripts/
public/weather-icons/design/brand*/
public/weather-icons/design/fill/*.html
public/weather-icons/design/line/
public/weather-icons/.gitignore
public/weather-icons/.editorconfig
public/weather-icons/package.json
public/weather-icons/pnpm-lock.yaml
public/weather-icons/README.md
public/weather-icons/LICENSE
public/weather-icons/*.html

# --- Duplicate font files (keep modern formats + fallbacks) ---
public/font/*.eot
public/font/*.svg
# Keep: woff2 (modern), woff (fallback), ttf (old browsers)

# --- Oxanium font extras (if using system fonts instead) ---
public/Oxanium/README.txt
public/Oxanium/OFL.txt
public/Oxanium/static/

# --- Python envs (if present) ---
.venv/
venv/
__pycache__/
*.pyc

# --- Exclude large PNGs ---
public/PNGS

# --- Duplicate/unused assets in pages folder ---
pages/assets/
pages/*.png
