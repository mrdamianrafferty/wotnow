// pages/api/findr/get-insights.ts
// Get personalized fishing insights for a user

import type { NextApiRequest, NextApiResponse } from 'next';
import {
  generateFishingInsights,
  type FishingInsight
} from '../../../lib/findr/generateInsights';

const hasSpecies = (insight: FishingInsight): insight is FishingInsight & { species: string } => {
  return typeof (insight as { species?: unknown }).species === 'string';
};

interface InsightsResponse {
  insights: FishingInsight[];
  generated_at: string;
}

interface ErrorResponse {
  error: string;
}

export default async function handler(
  req: NextApiRequest,
  res: NextApiResponse<InsightsResponse | ErrorResponse>
) {
  if (req.method !== 'GET') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { user_id, species } = req.query;

    // Validate query parameters
    const userId = user_id ? String(user_id) : null;
    const speciesName = species ? String(species) : null;

    // If no user_id, return general tips
    const fallbackInsights: FishingInsight[] = [];

    // If no user_id, return general tips
    if (!userId) {
      return res.status(200).json({
        insights: fallbackInsights,
        generated_at: new Date().toISOString(),
      });
    }

    // Generate personalized insights
    const allInsights = await generateFishingInsights(userId);
    let insights: FishingInsight[] = allInsights;

    if (speciesName) {
      const speciesInsights = allInsights
        .filter(hasSpecies)
        .filter(
          (insight) =>
            insight.species.toLowerCase() === speciesName.toLowerCase()
        );

      insights = speciesInsights.length > 0 ? speciesInsights : fallbackInsights;
    }

    return res.status(200).json({
      insights,
      generated_at: new Date().toISOString(),
    });
  } catch (error: unknown) {
    console.error('Error generating insights:', error);
    return res.status(500).json({
      error: error instanceof Error ? error.message : 'Internal server error',
    });
  }
}