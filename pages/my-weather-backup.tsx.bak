              <div className="text-center">                    <p className="text-lg font-bold text-orange-300">                      {tides.filter(t => t.type === 'low')[0]?.height?.toFixed(1) ?? '—'}m                    </p>                    <p className="text-xs text-white/60">Low</p>                  </div>                </div>              </div>            </div>          </div>        ) : (          <div className="text-center py-8">            <div className="w-16 h-16 mx-auto bg-white/10 rounded-full flex items-center justify-center mb-4">              <span className="text-2xl">🌊</span>            </div>            <p className="text-white/60">No tide data available</p>            <p className="text-white/40 text-sm mt-1">Check back later for updates</p>          </div>        )}      </div>    </div>  )}const UVCard: React.FC<{ uvi?: number }> = ({ uvi }) => {  const getUVLevel = (uv?: number) => {    if (!uv || uv < 0) return {       level: 'Unknown',       color: 'text-gray-300',       bg: 'bg-gray-500/20',      barColor: 'bg-gray-400',      description: 'No UV data available',      advice: 'Unable to provide UV guidance'    }    if (uv <= 2) return {       level: 'Low',       color: 'text-green-300',       bg: 'bg-green-500/20',      barColor: 'bg-green-400',      description: 'Minimal sun protection needed',      advice: 'Safe to be outside'    }    if (uv <= 5) return {       level: 'Moderate',       color: 'text-yellow-300',       bg: 'bg-yellow-500/20',      barColor: 'bg-yellow-400',      description: 'Some protection required',      advice: 'Seek shade during midday'    }    if (uv <= 7) return {       level: 'High',       color: 'text-orange-300',       bg: 'bg-orange-500/20',      barColor: 'bg-orange-400',      description: 'Protection essential',      advice: 'Wear sunscreen and hat'    }    if (uv <= 10) return {       level: 'Very High',       color: 'text-red-300',       bg: 'bg-red-500/20',      barColor: 'bg-red-400',      description: 'Extra protection required',      advice: 'Avoid sun 10am-4pm'    }    return {       level: 'Extreme',       color: 'text-purple-300',       bg: 'bg-purple-500/20',      barColor: 'bg-purple-400',      description: 'Avoid sun exposure',      advice: 'Stay indoors if possible'    }  }  const uvData = getUVLevel(uvi)  const uvProgress = Math.min((uvi ?? 0) / 12 * 100, 100) // Scale to 12+ as max  return (    <div className="glass-card rounded-3xl overflow-hidden hover-lift border border-white/30 shadow-xl backdrop-blur-2xl">      <div className="p-6">        <div className="flex items-center justify-between mb-6">          <div className="flex items-center gap-3">            <div className="relative">              <span className="text-2xl">☀️</span>              {(uvi ?? 0) > 6 && (                <div className="absolute -top-1 -right-1 w-3 h-3 bg-orange-400 rounded-full animate-ping"></div>              )}            </div>            <h3 className="text-lg font-semibold text-white/90">UV Index</h3>          </div>          <div className={`px-3 py-1 rounded-full text-xs font-medium ${uvData.bg} ${uvData.color} border border-white/20`}>            {uvData.level}          </div>        </div>                <div className="space-y-6">          {/* UV Index display with visual indicator */}          <div className="text-center">            <div className="relative inline-block mb-4">              <p className="text-5xl font-light text-white">{uvi?.toFixed(1) ?? '—'}</p>              {uvi && (                <div className="absolute -bottom-2 left-1/2 transform -translate-x-1/2">                  <div className="text-xs text-white/60">out of 12+</div>                </div>              )}            </div>                        {/* UV level bar */}            <div className="w-full bg-white/20 rounded-full h-3 mb-4 overflow-hidden">              <div                 className={`h-full ${uvData.barColor} rounded-full transition-all duration-1000 shadow-sm`}                style={{ width: `${uvProgress}%` }}              />                            {/* UV scale markers */}              <div className="flex justify-between mt-2 text-xs text-white/50">                <span>0</span>                <span>3</span>                <span>6</span>                <span>9</span>                <span>12+</span>              </div>            </div>          </div>                    {/* Protection advice */}          <div className="space-y-3">            <div className="p-4 bg-white/10 rounded-2xl border border-white/20">              <p className="text-sm font-medium text-white/90 mb-1">{uvData.description}</p>              <p className="text-xs text-white/70">{uvData.advice}</p>            </div>                        {/* Sun protection timeline */}            {uvi && uvi > 3 && (              <div className="p-4 bg-orange-500/10 rounded-2xl border border-orange-400/30">                <div className="flex items-center gap-2 mb-2">                  <span className="text-orange-300">🧴</span>                  <p className="text-sm font-medium text-orange-200">Protection Recommended</p>                </div>                <p className="text-xs text-orange-100/80">                  Peak UV: 11 AM - 3 PM • Reapply sunscreen every 2 hours                </p>              </div>            )}          </div>                    {/* UV forecast hint */}          <div className="pt-4 border-t border-white/20">            <div className="flex justify-between items-center text-sm">              <span className="text-white/60">Peak today:</span>              <span className="text-white/80">{uvi ? `${Math.ceil(uvi * 1.2).toFixed(1)} at midday` : '—'}</span>            </div>          </div>        </div>      </div>    </div>  )}const AtmosphericCard: React.FC<{ d?: UnifiedWeather }> = ({ d }) => {  const getPressureTrend = (pressure?: number) => {    if (!pressure) return {       trend: 'Unknown',       color: 'text-gray-300',       icon: '📊',      description: 'No pressure data'     }    if (pressure < 1000) return {       trend: 'Low',       color: 'text-blue-300',       icon: '📉',      description: 'Stormy weather likely'     }    if (pressure > 1020) return {       trend: 'High',       color: 'text-green-300',       icon: '📈',      description: 'Fair weather expected'     }    return {       trend: 'Normal',       color: 'text-yellow-300',       icon: '➡️',      description: 'Stable conditions'     }  }  const getVisibilityCondition = (visibility?: number) => {    if (!visibility) return { label: 'Unknown', color: 'text-gray-300' }    if (visibility >= 10) return { label: 'Excellent', color: 'text-green-300' }    if (visibility >= 5) return { label: 'Good', color: 'text-blue-300' }    if (visibility >= 2) return { label: 'Fair', color: 'text-yellow-300' }    if (visibility >= 1) return { label: 'Poor', color: 'text-orange-300' }    return { label: 'Very Poor', color: 'text-red-300' }  }  const getHumidityCondition = (humidity?: number) => {    if (!humidity) return { label: 'Unknown', color: 'text-gray-300' }    if (humidity < 30) return { label: 'Very Dry', color: 'text-orange-300' }    if (humidity < 50) return { label: 'Dry', color: 'text-yellow-300' }    if (humidity < 70) return { label: 'Comfortable', color: 'text-green-300' }    if (humidity < 85) return { label: 'Humid', color: 'text-blue-300' }    return { label: 'Very Humid', color: 'text-purple-300' }  }  const pressureData = getPressureTrend(d?.pressureHpa)  const visibilityData = getVisibilityCondition(d?.visibilityKm)  const humidityData = getHumidityCondition(d?.humidityPct)  return (    <div className="glass-card rounded-3xl overflow-hidden hover-lift border border-white/30 shadow-xl backdrop-blur-2xl">      <div className="p-6">        <div className="flex items-center gap-3 mb-6">          <span className="text-2xl">🌡️</span>          <h3 className="text-lg font-semibold text-white/90">Conditions</h3>        </div>                <div className="space-y-6">          {/* Barometric Pressure - Enhanced */}          <div className="p-4 bg-white/10 rounded-2xl border border-white/20">            <div className="flex items-center justify-between mb-3">              <div>                <p className="text-sm font-medium text-white/80 mb-1">Barometric Pressure</p>                <p className="text-2xl font-light text-white">{d?.pressureHpa ?? '—'}</p>                <p className="text-xs text-white/60">hPa / mbar</p>              </div>              <div className="text-right">                <div className={`flex items-center gap-2 ${pressureData.color} mb-1`}>                  <span className="text-lg">{pressureData.icon}</span>                  <span className="text-sm font-medium">{pressureData.trend}</span>                </div>                <p className="text-xs text-white/60">{pressureData.description}</p>              </div>            </div>                        {/* Pressure scale visualization */}            <div className="relative">              <div className="w-full bg-white/20 rounded-full h-2 mb-2">                <div                   className="h-full bg-gradient-to-r from-blue-400 to-green-400 rounded-full transition-all duration-1000"                  style={{                     width: `${Math.min(Math.max(((d?.pressureHpa ?? 1013) - 980) / 60 * 100, 0), 100)}%`                   }}                />              </div>              <div className="flex justify-between text-xs text-white/50">                <span>980</span>                <span>1013</span>                <span>1040</span>              </div>            </div>          </div>                    {/* Humidity & Visibility Grid */}          <div className="grid grid-cols-2 gap-4">            <div className="p-4 bg-white/10 rounded-2xl border border-white/20">              <div className="text-center">                <div className="flex items-center justify-center gap-2 mb-2">                  <span className="text-lg">💧</span>                  <span className={`text-xs font-medium ${humidityData.color}`}>                    {humidityData.label}                  </span>                </div>                <p className="text-xs text-white/60 uppercase tracking-wider mb-1">Humidity</p>                <p className="text-2xl font-light text-white">{d?.humidityPct ?? '—'}%</p>                                {/* Humidity comfort indicator */}                <div className="mt-2 w-full bg-white/20 rounded-full h-1">                  <div                     className="h-full bg-gradient-to-r from-orange-400 via-green-400 to-blue-400 rounded-full"                    style={{ width: `${Math.min(d?.humidityPct ?? 0, 100)}%` }}                  />                </div>              </div>            </div>                        <div className="p-4 bg-white/10 rounded-2xl border border-white/20">              <div className="text-center">                <div className="flex items-center justify-center gap-2 mb-2">                  <span className="text-lg">👁️</span>                  <span className={`text-xs font-medium ${visibilityData.color}`}>                    {visibilityData.label}                  </span>                </div>                <p className="text-xs text-white/60 uppercase tracking-wider mb-1">Visibility</p>                <p className="text-2xl font-light text-white">{d?.visibilityKm ?? '—'}</p>                <p className="text-xs text-white/60">km</p>              </div>            </div>          </div>                    {/* Additional atmospheric info */}          <div className="pt-4 border-t border-white/20">            <div className="grid grid-cols-2 gap-4 text-sm">              <div className="flex justify-between">                <span className="text-white/60">Sea Level:</span>                <span className="text-white/80">{d?.pressureHpa ?? '—'} hPa</span>              </div>              <div className="flex justify-between">                <span className="text-white/60">Dew Point:</span>                <span className="text-white/80">                  {d?.temperatureC && d?.humidityPct                     ? `${Math.round(d.temperatureC - (100 - d.humidityPct) / 5)}°C`                    : '—'                  }                </span>              </div>            </div>          </div>        </div>      </div>    </div>  )}const CloudsCard: React.FC<{ d?: UnifiedWeather }> = ({ d }) => {  const getCloudCover = (clouds?: number) => {