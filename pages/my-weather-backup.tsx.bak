// pages/my-weather.tsx
// Apple Weather-inspired Next.js + DaisyUI weather dashboard
// Beautiful, modular, mobile-first design with proper data visualization

import * as React from 'react'
import useSWR from 'swr'
import { useUserPreferences } from '../context/UserPreferencesContext'
import WeatherAnimationLayer, { UnifiedWeatherData } from '../components/WeatherAnimationLayer'

// Transform user preferences to weather location format
function transformLocationsForWeather(locations: { name: string; lat: number; lon: number; type?: string }[]): { label: string; lat: number; lon: number; mode: 'land'|'marine' }[] {
  const result: { label: string; lat: number; lon: number; mode: 'land'|'marine' }[] = []
  
  // Home location (land mode)
  const home = locations.find(l => l.type === 'home')
  if (home) {
    result.push({
      label: 'Home',
      lat: home.lat,
      lon: home.lon,
      mode: 'land'
    })
  }
  
  // Coastal location (marine mode)  
  const coastal = locations.find(l => l.type === 'coastal')
  if (coastal) {
    result.push({
      label: 'Coastal',
      lat: coastal.lat,
      lon: coastal.lon,
      mode: 'marine'
    })
  }
  
  // Fallback to Gijón if no locations found
  if (result.length === 0) {
    result.push({ label: 'Home', lat: 43.535, lon: -5.661, mode: 'land' })
  }
  
  return result
}

// Weather data types
type Hour = {
  timeISO: string
  tempC?: number
  pop?: number // 0..1
  windMS?: number
  windDeg?: number
  precipMM?: number
  icon?: string
}

type Day = {
  dateISO: string
  minC?: number
  maxC?: number
  pop?: number
  summary?: string
  icon?: string
}

type Tides = {
  time: string
  type: 'high' | 'low'
  height: number | null
}[]

type Marine = {
  waveHeight?: number | null
  waveDirection?: number | null
  wavePeriod?: number | null
  swellHeight?: number | null
  swellDirection?: number | null
  swellPeriod?: number | null
}

type UnifiedWeather = {
  name?: string
  lat: number
  lon: number
  isMarine?: boolean
  temperatureC?: number
  feelsLikeC?: number
  humidityPct?: number
  pressureHpa?: number
  windSpeedMS?: number
  windGustMS?: number
  windDeg?: number
  visibilityKm?: number
  uvi?: number
  cloudsPct?: number
  description?: string
  icon?: string
  hourly?: Hour[]
  daily?: Day[]
  marine?: Marine
  tides?: Tides
}

// Utility functions
const fetcher = (url: string) => fetch(url).then(r => {
  if (!r.ok) throw new Error(`HTTP ${r.status}`)
  return r.json()
})

function useMounted() {
  const [mounted, setMounted] = React.useState(false)
  React.useEffect(() => setMounted(true), [])
  return mounted
}

function fmtTimeShort(iso?: string) {
  if (!iso) return ''
  const d = new Date(iso)
  return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
}

function degToCardinal(deg?: number) {
  if (deg == null) return ''
  const dirs = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW']
  const i = Math.round((deg % 360) / 22.5) % 16
  return dirs[i]
}

function msToKts(v?: number) { return v == null ? undefined : Math.round(v * 1.94384) }
function msToMph(v?: number) { return v == null ? undefined : Math.round(v * 2.23694) }

// Weather icon mapping
function getWeatherIcon(icon?: string, description?: string) {
  if (!icon && !description) return '🌤️'
  
  const desc = (description || '').toLowerCase()
  if (desc.includes('rain') || desc.includes('shower')) return '🌧️'
  if (desc.includes('snow')) return '❄️'
  if (desc.includes('cloud')) return '☁️'
  if (desc.includes('clear') || desc.includes('sunny')) return '☀️'
  if (desc.includes('fog') || desc.includes('mist')) return '🌫️'
  if (desc.includes('thunder')) return '⛈️'
  
  // Fallback based on icon code patterns
  if (icon) {
    if (icon.includes('01')) return '☀️'
    if (icon.includes('02') || icon.includes('03')) return '⛅'
    if (icon.includes('04')) return '☁️'
    if (icon.includes('09') || icon.includes('10')) return '🌧️'
    if (icon.includes('11')) return '⛈️'
    if (icon.includes('13')) return '❄️'
    if (icon.includes('50')) return '🌫️'
  }
  
  return '🌤️'
}

// Convert UnifiedWeather to WeatherAnimationLayer format
function weatherToAnimationData(weather?: UnifiedWeather): UnifiedWeatherData | null {
  if (!weather) return null

  // Determine condition based on weather description and data
  let condition = 'clear'
  if (weather.description) {
    const desc = weather.description.toLowerCase()
    if (desc.includes('rain') || desc.includes('drizzle') || desc.includes('shower')) {
      condition = 'rain'
    } else if (desc.includes('snow') || desc.includes('sleet')) {
      condition = 'snow'
    } else if (desc.includes('fog') || desc.includes('mist') || (weather.visibilityKm && weather.visibilityKm < 5)) {
      condition = 'fog'
    } else if (desc.includes('cloud') || (weather.cloudsPct && weather.cloudsPct > 25)) {
      condition = 'cloudy'
    }
  }

  // Marine condition based on mode and wind
  if (weather.isMarine) {
    const windMS = weather.windSpeedMS || 0
    if (windMS < 3) condition = 'marine_calm'
    else if (windMS < 8) condition = 'marine_choppy'
    else condition = 'marine_storm'
  }

  return {
    condition,
    temperatureC: weather.temperatureC || 0,
    windSpeedMS: weather.windSpeedMS || 0,
    windDirectionDeg: weather.windDeg || 0,
    humidity: weather.humidityPct || 0,
    visibilityKM: weather.visibilityKm || 10,
    precipitationMMph: 0, // Would need hourly precip data
    isCoastal: weather.isMarine || false,
    applyBeaufort: weather.isMarine,
    localTimeISO: new Date().toISOString(),
  }
}

// Pull “home” + “coastal” from localStorage if present (fallback to Gijón area)
function _getDefaultLocations(): { label: string; lat: number; lon: number; mode: 'land'|'marine' }[] {
  if (typeof window !== 'undefined') {
    const homeLat = Number(localStorage.getItem('homeLat'))
    const homeLon = Number(localStorage.getItem('homeLon'))
    const coastLat = Number(localStorage.getItem('coastLat'))
    const coastLon = Number(localStorage.getItem('coastLon'))
    if (Number.isFinite(homeLat) && Number.isFinite(homeLon) && Number.isFinite(coastLat) && Number.isFinite(coastLon)) {
      return [
        { label: 'Home', lat: homeLat, lon: homeLon, mode: 'land' },
        { label: 'Coastal', lat: coastLat, lon: coastLon, mode: 'marine' },
      ]
    }
  }
  // sensible defaults (Gijón, ES)
  return [
    { label: 'Home', lat: 43.535, lon: -5.661, mode: 'land' },
    { label: 'Coastal', lat: 43.545, lon: -5.635, mode: 'marine' },
  ]
}

// ---------------- Weather Background with Overlay ----------------
const WeatherBackground: React.FC<{ weatherData?: UnifiedWeather }> = ({ weatherData }) => (
  <>
    {/* Animated weather background */}
    <WeatherAnimationLayer 
      weather={weatherToAnimationData(weatherData)} 
      mode="auto"
    />
    {/* Semi-transparent overlay for text readability */}
    <div
      className="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/20 via-black/10 to-black/30"
      aria-hidden
    />
  </>
)

