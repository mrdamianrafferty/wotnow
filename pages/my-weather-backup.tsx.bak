 text-sm font-bold">                            {t.type === 'high' ? '↑' : '↓'}                          </span>                        </div>                        <div className={`mt-1 w-1 h-4 rounded-full ${                          t.type === 'high' ? 'bg-cyan-400/60' : 'bg-orange-400/60'                        }`}></div>                      </div>                                            {/* Tide info */}                      <div>                        <div className="flex items-center gap-2">                          <p className={`font-semibold capitalize ${                            isNext ? 'text-cyan-200' : 'text-white/90'                          }`}>                            {t.type} Tide                          </p>                          {isNext && (                            <span className="px-2 py-1 bg-cyan-400/30 text-cyan-200 rounded-full text-xs font-medium">                              Next                            </span>                          )}                        </div>                        <p className={`text-sm ${                          isNext ? 'text-cyan-300/80' : 'text-white/60'                        }`}>                          {dayDisplay}                        </p>                                                {/* Tide height if available */}                        {t.height && (                          <p className="text-xs text-white/50 mt-1">                            Height: {t.height.toFixed(2)}m                          </p>                        )}                      </div>                    </div>                                        {/* Time display */}                    <div className="text-right">                      <p className={`text-xl font-bold ${                        isNext ? 'text-cyan-200' : 'text-white/90'                      }`}>                        {timeString}                      </p>                                            {/* Time until next tide */}          