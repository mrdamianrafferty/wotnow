{
  "version": 2,
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "NPM_CONFIG_PLATFORM": "linux",
      "NPM_CONFIG_ARCH": "x64",
      "FORCE_FRESH_BUILD": "true"
    }
  },
  "functions": {
    "pages/api/**/*.ts": {
      "maxDuration": 30,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "pages/api/findr/log-catch-enriched.ts": {
      "maxDuration": 60,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "pages/api/findr/identify-fish.ts": {
      "maxDuration": 60,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "app/api/**/*.ts": {
      "maxDuration": 30,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    }
  },
  "rewrites": [
    { "source": "/api/python/(.*)", "destination": "/api/python/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron-update-weather",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/ingest-copernicus",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/check-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly-forecast",
      "schedule": "0 8 * * 3"
    }
  ],
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/_next/static/chunks/pages/auth/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/findr/predictions",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=900, s-maxage=1800, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/findr/conditions",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=1800, s-maxage=3600, stale-while-revalidate=7200" }
      ]
    },
    {
      "source": "/api/findr/rectangles",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, immutable" }
      ]
    },
    {
      "source": "/api/weather",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=900, stale-while-revalidate=1800" }
      ]
    },
    {
      "source": "/api/moon",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=7200, stale-while-revalidate=14400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/_next/image(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/weather-icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/skies/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/waves/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}