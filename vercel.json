{
  "version": 2,
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "NPM_CONFIG_PLATFORM": "linux",
      "NPM_CONFIG_ARCH": "x64",
      "FORCE_FRESH_BUILD": "true"
    }
  },
  "functions": {
    "pages/api/**/*.ts": {
      "maxDuration": 30,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "pages/api/call/share.ts": {
      "maxDuration": 30,
      "includeFiles": "public/call-photos/**",
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "pages/api/findr/log-catch-enriched.ts": {
      "maxDuration": 60,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "pages/api/findr/identify-fish.ts": {
      "maxDuration": 60,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "pages/api/cron/godaisy/daily-call.ts": {
      "maxDuration": 300,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    },
    "app/api/**/*.ts": {
      "maxDuration": 30,
      "excludeFiles": "{tmp/**,__tests__/**,*.test.ts,*.test.tsx,docs/**,archive/**,supabase/migrations/**,scripts/**,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/api/python/(.*)",
      "destination": "/api/python/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-cache",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-update-weather",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/ingest-copernicus",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/send-plan-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/seed-planting-calendar",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/grow/weather-task-alerts",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/grow/local-signal-alerts",
      "schedule": "0 3,9,15,21 * * *"
    },
    {
      "path": "/api/cron/godaisy/daily-call",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/_next/static/chunks/pages/auth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.cookie-script.com https://cdn.vercel-insights.com https://*.sentry.io https://va.vercel-scripts.com https://maps.googleapis.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.openweathermap.org https://api.stormglass.io https://api.met.no https://nrt.cmems-du.eu https://my.cmems-du.eu https://maps.googleapis.com https://places.googleapis.com https://ipapi.co https://*.sentry.io https://va.vercel-scripts.com https://vitals.vercel-insights.com https://cdn.cookie-script.com https://api-free.deepl.com https://api.resend.com https://api.stripe.com https://grewp.org; frame-src 'self' https://accounts.google.com https://appleid.apple.com https://js.stripe.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/findr/predictions",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=1800, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/findr/conditions",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=3600, stale-while-revalidate=7200"
        }
      ]
    },
    {
      "source": "/api/findr/rectangles",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, immutable"
        }
      ]
    },
    {
      "source": "/api/weather",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=900, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/api/moon",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=7200, stale-while-revalidate=14400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/_next/image(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/weather-icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/skies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/waves/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/webp/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/PNGS/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpeg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
