+const badgeForUv = (uv?: number): string => {
+  if (!uv) return 'badge-neutral';
+  if (uv <= 2) return 'badge-success';
+  if (uv <= 5) return 'badge-warning';
+  if (uv <= 7) return 'badge-warning';
+  if (uv <= 10) return 'badge-error';
