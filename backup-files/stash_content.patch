+// Helper functions (moved from main file)
+const fmtTimeHM = (iso?: string) => {
+  if (!iso) return '—';
+  try {
+    return new Date(iso).toLocaleTimeString('en-US', { 
+      hour: '2-digit', 
+      minute: '2-digit',
+      hour12: false 
+    });
+  } catch {
+    return '—';
+  }
+};
+
+const degToCompassHourly = (deg?: number) => {
