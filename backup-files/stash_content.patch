+      <div className="text-xs opacity-80 mb-2">{description}</div>
+      
+      {value !== undefined && currentRange ? (
+        <div className="border-t border-white/10 pt-2 mt-1">
+          <div className="text-sm mb-1 font-medium">{currentRange.level}</div>
