+#!/bin/bash
+
+echo "🧪 Testing manual autocomplete UX - smooth typing without interruptions"
+echo "========================================================================"
+
+echo ""
+echo "📋 Test Instructions:"
+echo "1. Open the location dialog"
+echo "2. Start typing in the search box"
+echo "3. Verify:"
+echo "   - Typing is smooth and uninterrupted"
+echo "   - No interference or cursor jumping"
+echo "   - Suggestions appear after 3+ characters"
+echo "   - Loading indicator shows briefly after typing"
+echo "   - Can clear search with X button"
+echo "   - Escape key clears search"
+echo "   - Can select suggestions without errors"
+echo ""
+
+# Start the development server
+echo "🚀 Starting development server..."
+cd /Users/damianrafferty/Projects/WotNow
+
+# Check if server is already running
+if lsof -Pi :3000 -sTCP:LISTEN -t >/dev/null ; then
+    echo "✅ Development server already running on http://localhost:3000"
+else
+    echo "Starting Next.js development server..."
+    npm run dev &
+    DEV_PID=$!
+    
+    # Wait for server to start
+    echo "⏳ Waiting for server to start..."
+    sleep 5
+    
+    # Check if server started successfully
+    if lsof -Pi :3000 -sTCP:LISTEN -t >/dev/null ; then
+        echo "✅ Server started successfully!"
+    else
+        echo "❌ Server failed to start"
+        exit 1
+    fi
+fi
+
+echo ""
+echo "🌐 Opening browser to test manual autocomplete UX..."
+echo "📍 Go to http://localhost:3000/my-new-weather"
+echo ""
+echo "🎯 Test Points:"
+echo "   ✓ Smooth typing experience"
+echo "   ✓ No cursor jumping or interference"
+echo "   ✓ Suggestions after 3+ chars with 800ms debounce"
+echo "   ✓ Loading indicator during search"
+echo "   ✓ Clear button works"
+echo "   ✓ Escape key clears search"
+echo "   ✓ Suggestion selection works"
+echo "   ✓ Geocoding works for selected suggestions"
+echo ""
+
+# Open browser (macOS)
+if command -v open &> /dev/null; then
+    open "http://localhost:3000/my-new-weather"
+else
+    echo "Please open http://localhost:3000/my-new-weather in your browser"
+fi
+
+echo ""
+echo "Press Enter when done testing..."
+read -r
+
+# Clean up
+if [ ! -z "$DEV_PID" ]; then
+    echo "🛑 Stopping development server..."
+    kill $DEV_PID 2>/dev/null || true
+fi
+
+echo "✅ Test complete!"
