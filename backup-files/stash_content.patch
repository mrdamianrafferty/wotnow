+    #83DE00 20%, 
+    #FFFF00 30%, 
+    #FFC000 40%, 
+    #FF7E00 50%, 
+    #FF5000 60%, 
+    #FF0000 70%, 
+    #AA4BA8 80%, 
+    #8F3F97 90%, 
+    #7E0023 100%
