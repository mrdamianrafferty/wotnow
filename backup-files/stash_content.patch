+                          src={it.sub === 'sunrise' ? '/weather-icons/design/fill/final/sunrise.svg' : '/weather-icons/design/fill/final/sunset.svg'} 
+                          alt="" 
+                          className="w-16 h-16 mx-auto my-2" 
+                        />
+                        <div className="text-sm font-semibold capitalize">{it.sub}</div>
+                      </div>
+                    </div>
+                  </div>
+                )}
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
