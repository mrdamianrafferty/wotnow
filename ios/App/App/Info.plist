	<!-- Location Permissions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Findr needs your location to show fishing predictions for your area and help you discover the best spots nearby.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Findr can use your location in the background to send you timely fishing notifications when conditions are ideal.</string>

	<!-- Camera Permission -->
	<key>NSCameraUsageDescription</key>
	<string>Findr needs camera access to let you take photos of your catches and document your fishing sessions.</string>

	<!-- Photo Library Permissions -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Findr needs access to your photo library to let you select and upload photos of your catches.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Findr needs permission to save catch photos to your photo library.</string>

	<!-- Notifications Permission -->
	<key>NSUserNotificationsUsageDescription</key>
	<string>Findr can send you notifications about optimal fishing conditions and reminders for your scheduled sessions.</string>

	<!-- Motion Permission -->
	<key>NSMotionUsageDescription</key>
	<string>Findr uses motion data to detect whether you are fishing from a boat or the shore to give you targeted advice.</string>

