{
  "name": "wotnow-web-app",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "prebuild": "",
    "prevercel-build": "",
    "postinstall": "git config core.hooksPath .githooks || true",
    "clean:dev": "bash ./scripts/clean-dev.sh",
    "dev": "node ./scripts/ensure-next-manifests.cjs && next dev --webpack",
    "dev:turbo": "node ./scripts/ensure-next-manifests.cjs && next dev",
    "dev:clean": "npm run clean:dev && npm run dev",
    "build": "next build --webpack",
    "postbuild": "",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:strict": "npm run lint:ci && next build --webpack",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "deploy": "./deploy.sh",
    "deploy:quick": "./quick-deploy.sh",
    "astro:canaries": "cd services/astro_highlights/astro_highlights && .venv/bin/python run_canaries.py",
    "test:wind": "jest __tests__/windRecommendations.test.ts",
    "demo:wind": "tsx test-scripts/demo-wind.ts",
    "demo:soil": "tsx test-scripts/demo-soil.ts",
    "validate:taxonomy": "tsx scripts/validateTaxonomy.ts",
    "merge:activities": "tsx scripts/mergeActivityBackfill.ts",
    "env:sync": "tsx scripts/env-sync.ts",
    "migrate:species-data": "tsx scripts/migrate-species-fishing-data.ts",
    "seed:findr:rectangles": "tsx scripts/seedFindrRectangles.ts",
    "seed:findr:conditions": "tsx scripts/seedFindrConditionsSnapshot.ts",
    "optimize-images": "tsx scripts/optimize-activity-images.ts",
    "smoke": "bash scripts/smoke-unified.sh",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "mobile:dev:ios": "npx cap run ios --livereload --external --host=0.0.0.0",
    "mobile:dev:android": "npx cap run android --livereload --external --host=0.0.0.0",
    "cap:growdaisy:sync": "CAPACITOR_CONFIG=capacitor.config.growdaisy.ts npx cap sync",
    "cap:growdaisy:open:ios": "npx cap open ios-growdaisy",
    "cap:growdaisy:open:android": "npx cap open android-growdaisy",
    "cap:growdaisy:build:ios": "npx cap copy ios-growdaisy && cd ios-growdaisy/App && pod install",
    "cap:growdaisy:build:android": "npx cap copy android-growdaisy"
  },
  "resolutions": {
    "next": {
      "swc": true
    }
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
