					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- PERMISSIONS -->

	<!-- Location Permissions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Grow Daisy needs your location to show local climate data and provide planting recommendations for your area.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Grow Daisy can use your location in the background to send timely garden reminders based on local weather.</string>

	<!-- Camera Permission -->
	<key>NSCameraUsageDescription</key>
	<string>Grow Daisy needs camera access so you can photograph your plants and garden progress.</string>

	<!-- Photo Library Permissions -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Grow Daisy needs photo library access so you can attach existing pictures to your plant logs.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Grow Daisy needs permission to save garden photos to your library.</string>

	<!-- Notifications Permission -->
	<key>NSUserNotificationsUsageDescription</key>
	<string>Grow Daisy can send you notifications for watering reminders, planting windows, and garden care tips.</string>

	<!-- Motion Permission -->
	<key>NSMotionUsageDescription</key>
	<string>Grow Daisy uses motion data to understand if you are at home or travelling so garden reminders stay relevant.</string>

