import type { ActivityType } from './activities/types';
export type { ActivityType } from './activities/types';
import allSports from './activities/index';
// If your tsconfig uses NodeNext and still can’t resolve, try:
// import allSports from './activities/index.js';

// Legacy base now empty (we source from category files). Add non-sports here if needed.
const baseActivities: ActivityType[] = [];

// Build a set of IDs from the category aggregator (typed to avoid implicit any)
const SPORT_IDS = new Set<string>((allSports as ActivityType[]).map((a: ActivityType) => a.id));

const baseNonSports: ActivityType[] = baseActivities.filter(a => !SPORT_IDS.has(a.id));

// Merge: category definitions are source of truth; base can add non-sports
const merged = new Map<string, ActivityType>(
  [...baseNonSports, ...(allSports as ActivityType[])].map((a) => [a.id, a])
);

