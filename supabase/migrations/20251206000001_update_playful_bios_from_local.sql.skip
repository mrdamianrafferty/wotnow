-- Log how many were updated
DO $$
DECLARE
  updated_count INTEGER;
BEGIN
  SELECT COUNT(*) INTO updated_count FROM species WHERE playful_bio_en IS NOT NULL AND playful_bio_en != '';
  RAISE NOTICE 'Species with playful bios after migration: %', updated_count;
END $$;
