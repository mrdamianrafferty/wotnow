# Required Environment Variables for Vercel Deployment
# Add these in your Vercel Dashboard > Project Settings > Environment Variables

# =============================================================================
# REQUIRED - Core Database
# =============================================================================

# Supabase - Get these from your Supabase project settings
# IMPORTANT: Keep SUPABASE_SERVICE_ROLE_KEY secret - never expose to client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# =============================================================================
# REQUIRED - Weather APIs
# =============================================================================

NEXT_PUBLIC_OPENWEATHER_KEY=your_openweather_api_key
STORMGLASS_SECRET_KEY=your_stormglass_api_key

# =============================================================================
# REQUIRED - Google Maps
# =============================================================================

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# REQUIRED - Translations (DeepL)
# =============================================================================

# Get your API key from https://www.deepl.com/pro-api
# Free tier: 500,000 characters/month
DEEPL_API_KEY=your_deepl_api_key
TRANSLATION_ADMIN_TOKEN=set_a_secure_random_token

# =============================================================================
# APP CONFIGURATION - Per-Domain URLs
# =============================================================================

# Base URLs for each app (used for canonical URLs, sharing, etc.)
NEXT_PUBLIC_BASE_URL=https://godaisy.io
NEXT_PUBLIC_BASE_URL_GODAISY=https://godaisy.io
NEXT_PUBLIC_BASE_URL_FINDR=https://fishfindr.eu
NEXT_PUBLIC_BASE_URL_GROW=https://grow.godaisy.io

# =============================================================================
# OPTIONAL - Other APIs
# =============================================================================

EVENTBRITE_API_KEY=your_eventbrite_api_key
N2YO_API_KEY=your_n2yo_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Copernicus Marine Service (migration scaffolding)
COPERNICUS_ENABLED=false
COPERNICUS_PROVIDER=mock
COPERNICUS_USERNAME=your_cmems_username
COPERNICUS_PASSWORD=your_cmems_password
COPERNICUS_TOKEN=optional_toolbox_token

# Email Notifications (Resend)
# Get your API key from https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100/day
RESEND_API_KEY=re_your_resend_api_key

# Cron Job Authentication
# Generate a random secret for cron job security
# Example: openssl rand -base64 32
CRON_SECRET=your_secure_random_secret

# Fish Identification AI
# Choose your AI provider for fish identification
# Options: "openai" (default, €0.05/call) or "huggingface" (€0.001/call, 20x cheaper)
FISH_ID_PROVIDER=openai

# OpenAI API (for fish identification with GPT-4 Vision)
# Get your API key from https://platform.openai.com/api-keys
# Cost: ~€0.05 per identification (gpt-4o with high detail)
OPENAI_API_KEY=sk-your_openai_api_key

# HuggingFace Inference API (alternative fish identification provider)
# Get your token from https://huggingface.co/settings/tokens
# Cost: Free tier (30k requests/month), then ~€0.001 per request
HUGGINGFACE_API_TOKEN=hf_your_huggingface_token

# Mobile App Configuration (iOS/Android via Capacitor)
# These variables are OPTIONAL - only required if deploying native mobile apps

# =============================================================================
# ERROR TRACKING - Sentry (Recommended for Production)
# =============================================================================

# Get your DSN from https://sentry.io after creating projects
# Create separate projects for each app domain for better error isolation

# Server-side DSN (shared across all apps)
SENTRY_DSN=https://your-server-dsn@sentry.io/project-id

# Client-side DSNs (per-domain for better tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-default-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN_GODAISY=https://your-godaisy-dsn@sentry.io/godaisy-project
NEXT_PUBLIC_SENTRY_DSN_FINDR=https://your-findr-dsn@sentry.io/findr-project
NEXT_PUBLIC_SENTRY_DSN_GROW=https://your-grow-dsn@sentry.io/grow-project

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================

# Google Analytics 4 / Firebase Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id

# Plausible Analytics (privacy-focused alternative)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=godaisy.io

# =============================================================================
# PUSH NOTIFICATIONS (Optional)
# =============================================================================

# Firebase Cloud Messaging
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable PWA features (service worker, offline support)
NEXT_PUBLIC_ENABLE_PWA=true

# Debug logging for Findr predictions (disable in production)
FINDR_DEBUG_LOGGING=false

# Bundle analyzer (set to true to analyze bundle size)
# ANALYZE=false

# =============================================================================
# MOBILE APP CONFIGURATION (Optional - for Capacitor builds)
# =============================================================================

# These are configured in capacitor.config.*.ts files
# APP_VERSION=1.0.0
# APP_BUILD_NUMBER=1
# APP_ID=eu.fishfindr.app
